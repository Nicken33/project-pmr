# Скопируйте в .env.production (для сборки) или .env.local (для разработки).

# Адрес Go API без "/" в конце. Пусто — запросы идут на тот же домен,
# где лежит сайт (/api/..., /media/...) — так проще всего на хостинге (без CORS).
VITE_API_URL=

# Google OAuth Client ID (тот же, что GOOGLE_CLIENT_ID у бэка). Пусто — кнопка Google скрыта.
VITE_GOOGLE_CLIENT_ID=

# Только для npm run dev: куда проксировать /api и /media.
DEV_API_PROXY=http://localhost:8080

# Почта команды для претензий и просьб убрать запись (страницы «О проекте», «Обработка данных»).
VITE_CONTACT_EMAIL=talentro.pmr@gmail.com

# Заготовки функций, которых ещё нет в бэке (см. BACKEND_INTEGRATION.md §4), через запятую:
# review_votes,review_comments,not_found_requests,popular_searches,avatar,org_logo,republish
VITE_FEATURES=
