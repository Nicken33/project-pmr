POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=postgres

# Переменные Go-бэкенда (backend/Talentro, internal/config/config.go).
# Без DATABASE_URL и MODERATOR_TOKEN конфиг не загружается и сервер не стартует.
# DATABASE_URL — строка lib/pq; для docker-compose это хост db, порт 5432.
# DATABASE_URL=postgres://postgres:your_password_here@localhost:5432/postgres?sslmode=disable
# MODERATOR_TOKEN=change-me
# PORT=8080
# ALLOWED_ORIGINS=http://localhost:3000

# Адрес Go-бэкенда для фронтенда. Скопировать в web/.env.local как
# NEXT_PUBLIC_API_URL=http://localhost:8080 — без переменной каталог работает на моках.
# NEXT_PUBLIC_API_URL=
