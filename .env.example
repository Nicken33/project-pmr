# Шаблон .env для docker-compose.yml, который лежит рядом в этом же каталоге.
#
# Как пользоваться:
#   cp .env.example .env && chmod 600 .env      # и заполнить значения
#
# .env в .gitignore — сюда входят только ИМЕНА переменных и безопасные значения по
# умолчанию. Реальных паролей, токенов и ключей здесь быть не должно (§6.7), и в
# коммит они не едут никогда. docker compose читает этот файл сам, на docker run и
# docker compose up -d ничего передавать не нужно.
#
# Порядок: сначала значения, которые нельзя подсмотреть (пароль базы, ключ подписи
# куки, client id Google), потом адреса, потом необязательное.

# --- Postgres (сервис db) ----------------------------------------------------
POSTGRES_USER=talentro
POSTGRES_DB=main_db
# Минимум 20 символов, без кавычек и пробелов: строка попадает в DATABASE_URL
# как есть. Сгенерировать: openssl rand -base64 24
POSTGRES_PASSWORD=

# --- Go-бэкенд (сервис api, internal/config/config.go) ----------------------
# DATABASE_URL compose собирает сам из трёх значений выше и хоста db:5432 — его
# задавать не нужно. Он понадобится только для запуска вне контейнера:
# DATABASE_URL=postgres://talentro:PAROL@127.0.0.1:5432/main_db?sslmode=disable
#
# MODERATOR_TOKEN убран: переменная появилась вместе с конфигурацией модераторского
# среза (§9.12), но ни один обработчик её не читает — эндпоинты кабинета есть и
# проверяют роль из куки сессии и users.account_type.
# Конфиг требовал значение, которое ничего не защищает, и без него api не стартовал:
# это ломало приёмку чаще, чем берегло прод. Обязательны только DATABASE_URL и
# SESSION_SECRET.
# HMAC-ключ подписи куки talentro_session (§3.7, §12.1). Без него api не
# стартует: вход неподписанной кукой — это вход, который любой посетитель
# соберёт сам. Значение, начатое с CHANGE_ME, api тоже отбраковывает — длина у
# заглушки достаточная, так что проверка длины её не ловит, а подпись между тем
# известна любому, кто открыл репозиторий. Сгенерировать: openssl rand -hex 32
# Менять нельзя — с новым ключом всех разлогинит, старые куки перестанут читаться.
SESSION_SECRET=
# Токен входа проверочной сессии (POST /api/auth/tester). Пустой — вход отключён
# (503), а не открыт всем. Заглушка CHANGE_ME — отказ старта по той же причине,
# что у SESSION_SECRET. Сгенерировать: openssl rand -hex 32
TESTER_TOKEN=
# Web-клиент Google OAuth 2.0 — то же значение, что NEXT_PUBLIC_GOOGLE_CLIENT_ID
# ниже (сервер сверяет aud токена). Пустой — POST /api/auth/google отвечает 503.
GOOGLE_CLIENT_ID=
# Список origin'ов для CORS через запятую. Пустой = междоменным запросам отказано.
# При одном домене (витрина и /api/* с одного origin) оставлять пустым; вписать
# origin стенда, если витрина живёт на другом порту или поддомене.
ALLOWED_ORIGINS=
# MEDIA_DIR — каталог медиа для самого Go-процесса: оттуда раздаётся GET /media/*
# и туда пишут загрузки владельца (internal/config/config.go, умолчание ./media).
# В docker-стеке значение задаёт compose (/srv/media), и .env на контейнер не
# влияет: путь внутри контейнера обязан совпадать с `root * /srv/media` в
# infra/Caddyfile, поэтому менять его незачем. Переменная нужна, только когда
# бинарник запускается вне Docker — тогда она должна указывать на тот же каталог,
# что MEDIA_HOST_DIR:
# MEDIA_DIR=/srv/media

# --- Домен и HTTPS (сервис caddy, infra/Caddyfile) --------------------------
# Только домен без схемы и слэша; на него должна указывать A-запись.
# localhost = HTTP без сертификата, для проверки конфигурации локально.
DOMAIN=talentro.example
# Каталог медиа на ХОСТЕ. Его видят оба контейнера и оба называют его /srv/media:
# api монтирует на запись (сюда ложатся загрузки владельца), caddy — только на
# чтение (раздача /media/*). Пути в БД начинаются с /media/ (§7.14), поэтому
# раздача и запись обязаны разрешаться в одни и те же файлы: разведёте каталоги —
# загруженное фото будет лежать на диске и отдавать 404 с витрины.
# Каталог должен переживать пересборку образов (bind mount, как здесь) и владельцем
# иметь uid 10001:10001 из backend/Talentro/Dockerfile. infra/setup-server.sh
# создаёт /srv/media, но отдаёт его пользователю deploy — этого хватает на чтение
# и не хватает на запись, поэтому перед первым запуском:
#   sudo chown -R 10001:10001 /srv/media
# Иначе фото из тома отдаются, а каждая загрузка отвечает 500 (docs/deploy.md §8).
MEDIA_HOST_DIR=/srv/media

# --- Витрина Next.js (сервис web) -------------------------------------------
# Публичный адрес API, который видит браузер. NEXT_PUBLIC_* встраиваются в клиентский
# бандл на этапе build: после изменения нужна пересборка образа (docs/deploy.md §4.1).
NEXT_PUBLIC_API_URL=https://talentro.example
# Публичный адрес самой витрины (§9.11, метаданные).
NEXT_PUBLIC_SITE_URL=https://talentro.example
# Google OAuth client id (web-клиент). Без него кнопка входа не показывается.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Другой сервис с /api/auth/*; по умолчанию совпадает с NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_AUTH_URL=

# --- Необязательное ---------------------------------------------------------
# Тег сборки: попадает в имена образов talentro-api:<версия> и в /health (§9.1).
APP_VERSION=dev
# Часовой пояс контейнеров. Проверяется на стенде; «today» и «проверено за 90
# дней» (§7.11) считаются по current_date базы.
TZ=Europe/Chisinau
