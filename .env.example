# Шаблон .env для docker-compose.yml, который лежит рядом в этом же каталоге.
#
# Как пользоваться:
#   cp .env.example .env && chmod 600 .env      # и заполнить значения
#
# .env в .gitignore — сюда входят только ИМЕНА переменных и безопасные значения по
# умолчанию. Реальных паролей, токенов и ключей здесь быть не должно (§6.7), и в
# коммит они не едут никогда. docker compose читает этот файл сам, на docker run и
# docker compose up -d ничего передавать не нужно.
#
# Порядок: сначала значения, которые нельзя подсмотреть (пароль базы, токен
# модератора, client id Google), потом адреса, потом необязательное.

# --- Postgres (сервис db) ----------------------------------------------------
POSTGRES_USER=talentro
POSTGRES_DB=main_db
# Минимум 20 символов, без кавычек и пробелов: строка попадает в DATABASE_URL
# как есть. Сгенерировать: openssl rand -base64 24
POSTGRES_PASSWORD=

# --- Go-бэкенд (сервис api, internal/config/config.go) ----------------------
# DATABASE_URL compose собирает сам из трёх значений выше и хоста db:5432 — его
# задавать не нужно. Он понадобится только для запуска вне контейнера:
# DATABASE_URL=postgres://talentro:PAROL@127.0.0.1:5432/main_db?sslmode=disable
#
# Токен модераторского среза (§9.12). Без него конфиг не загружается и api не
# стартует. Сгенерировать: openssl rand -hex 32
MODERATOR_TOKEN=
# Ключ HMAC-подписи куки talentro_session. Без него api не стартует (internal/
# config/config.go). Менять нельзя: смена секрета гасит все активные сессии.
# Сгенерировать: openssl rand -hex 32
SESSION_SECRET=
# Токен демо-входа тестировщика (POST /api/auth/tester). Пустой = вход отключён.
# Только для стенда приёмки, на публичном контуре оставлять пустым.
TESTER_TOKEN=
# Server-side проверка ID-токена Google (совпадает с NEXT_PUBLIC_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=
# Список origin'ов для CORS через запятую. Пустой = междоменным запросам отказано.
# При одном домене (витрина и /api/* с одного origin) оставлять пустым; вписать
# origin стенда, если витрина живёт на другом порту или поддомене.
ALLOWED_ORIGINS=

# --- Домен и HTTPS (сервис caddy, infra/Caddyfile) --------------------------
# Только домен без схемы и слэша; на него должна указывать A-запись.
# localhost = HTTP без сертификата, для проверки конфигурации локально.
DOMAIN=talentro.example
# Куда на хосте лежат файлы, которые раздаёт /media/* (пути в БД начинаются с
# /media/, §7.14). infra/setup-server.sh создаёт /srv/media.
MEDIA_HOST_DIR=/srv/media

# --- Витрина Next.js (сервис web) -------------------------------------------
# Публичный адрес API, который видит браузер. NEXT_PUBLIC_* встраиваются в клиентский
# бандл на этапе build: после изменения нужна пересборка образа (docs/deploy.md §4.1).
NEXT_PUBLIC_API_URL=https://talentro.example
# Публичный адрес самой витрины (§9.11, метаданные).
NEXT_PUBLIC_SITE_URL=https://talentro.example
# Google OAuth client id (web-клиент). Без него кнопка входа не показывается.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Другой сервис с /api/auth/*; по умолчанию совпадает с NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_AUTH_URL=

# --- Необязательное ---------------------------------------------------------
# Тег сборки: попадает в имена образов talentro-api:<версия> и в /health (§9.1).
APP_VERSION=dev
# Часовой пояс контейнеров. Проверяется на стенде; «today» и «проверено за 90
# дней» (§7.11) считаются по current_date базы.
TZ=Europe/Chisinau
