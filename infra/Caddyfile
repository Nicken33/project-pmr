# ==============================================================================
# Caddy: точка входа всего стенда. Один домен, автоматический HTTPS.
#
#   /api/*    → Go-бэкенд (api:8080)
#   /media/*  → файлы из тома /srv/media (§7.14: в базе путь уже «/media/…»)
#   всё остальное → витрина Next.js (web:3000)
#
# Домен приходит из переменной DOMAIN (docker-compose.yml и
# infra/docker-compose.caddy.yml передают её одинаково), поэтому файл один и для
# локальной проверки, и для VDS. Без DOMAIN/site_config Caddy не стартует.
#
# Важно: /health наружу не проброшен (§9.1 — служебный эндпоинт, его проверяют
# внутри сети: docker compose exec api wget -qO- http://127.0.0.1:8080/health).
# ==============================================================================

{$DOMAIN:localhost} {
    encode gzip zstd

    log {
        output file /var/log/caddy/access.log {
            roll_size 10MB
            roll_keep 5
        }
    }

    # Заголовки доверия к статике. Отдельно отмечено, чего здесь нет: строгой CSP
    # — она требует согласования с фронтендом (inline-стили Next и тайлы Leaflet
    # ломаются первыми), и ограничения по частоте — rate_limit считать с
    # X-Forwarded-For нельзя, а настоящего IP клиента Caddy за docker-сети не
    # видит (см. записку «кто видит IP клиента» в docs/deploy.md §8).
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
        -X-Powered-By
    }

    # 1. API бэкенда (§9). Маршрут объявлен до витрины, иначе /api/* уйдёт в Next.
    handle /api/* {
        reverse_proxy api:8080 {
            header_up X-Real-IP {remote_host}
        }
    }

    # 2. Медиа: раздача с диска, а не через приложение — file_server умеет Range
    # (без него видео не перематывается) и не тратит воркер Go на статику.
    # handle_path срезает префикс /media, поэтому /media/cards/1/palitra.jpg
    # читается как /srv/media/cards/1/palitra.jpg.
    #
    # Том у Caddy только на чтение, и этого достаточно: файлы туда пишет бэкенд
    # (POST /api/v1/me/activities/{id}/photos|videos), у него тот же каталог хоста
    # смонтирован на запись. Активные форматы загрузка не принимает, поэтому
    # file_server отдаёт из тома только картинки и видео.
    #
    # Маршрут GET|HEAD /media/* есть и у самого Go (route.go) — это запасной путь
    # для хоста без reverse proxy, где Caddy нет; здесь он не используется.
    handle_path /media/* {
        root * /srv/media
        file_server
    }

    # 3. Витрина. Next 16 (`next start`) слушает 3000, а не 80 — порт 80 у
    # контейнеров занимает только Caddy.
    handle {
        reverse_proxy web:3000
    }
}
