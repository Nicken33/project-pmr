PORT=8080
DATABASE_URL=postgresql://catalog_app:CHANGE_ME@127.0.0.1:5432/main_db?sslmode=disable
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# MODERATOR_TOKEN здесь больше нет: конфигурация требовала значение для
# модераторского среза (§9.12), но ни один обработчик его не читает, а без него
# сервер отказывался стартовать. Требование снято — кабинет §3.8/§9.12 принесёт
# свою переменную вместе с кодом, который её проверяет.
# Google OAuth 2.0 Web client ID (same value as NEXT_PUBLIC_GOOGLE_CLIENT_ID in web/.env).
# Пока не задан, POST /api/auth/google отвечает 503 — вход не открывается «на любом токене».
GOOGLE_CLIENT_ID=
# HMAC-ключ куки talentro_session. Обязателен и не короче 32 байт, иначе сервер
# не стартует: короткий ключ кто угодно подберёт офлайн. Значение ниже — заглушка
# из шаблона, её сервер тоже отбраковывает (по началу «CHANGE_ME»), чтобы
# неотредактированный .env не поднялся с подписью, известной из репозитория.
# Сгенерируйте:
#   export SESSION_SECRET="$(openssl rand -hex 32)"
SESSION_SECRET=CHANGE_ME_MIN_32_BYTES_USE_OPENSSL_RAND_HEX_32
# Токен входа для проверки (POST /api/auth/tester). Пустой — вход отключён.
# CHANGE_ME здесь — та же заглушка: процесс не стартует, а вход тестировщика
# открылся бы паролем, который любой читает репозиторий.
TESTER_TOKEN=CHANGE_ME
# Один каталог и на запись загрузок, и на раздачу GET|HEAD /media/*. Умолчание
# ./media рядом с процессом; на хосте задайте постоянный путь (/srv/media) и
# владельца uid 10001, иначе загрузки исчезнут при пересборке контейнера.
MEDIA_DIR=./media
