# Файлы, которые не уезжают в build-контекст. Главный смысл — .env: в нём реальные
# DATABASE_URL, MODERATOR_TOKEN и ALLOWED_ORIGINS локального стенда, а приложение
# умеет подхватывать .env из рабочей папки (godotenv в internal/config). Если он
# попадёт в контекст, секреты разработчика окажутся в слоях образа и уедут в registry.

.env
.env.*
*.pem
*.key

# Артефакты локальных сборок и тестов: в образе свой бинарник из стадии build.
bin/
dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.*

# Логи и временные файлы отладки
*.log
tmp/
.tmp/

# Git и редакторы: истории и настройки в образе не нужны
.git/
.gitignore
.vscode/
.idea/
*.swp

# Док-файлы не участвуют в сборке
*.md
