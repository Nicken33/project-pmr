# Public (exposed to browser) — Google OAuth 2.0 Web client ID.
# Create it in Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized JavaScript origins: http://localhost:3000 (and your production domain).
# Authorized redirect URIs: not required for the implicit/credential flow used here.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Backend API base URL (leave empty to use same-origin /api).
NEXT_PUBLIC_API_URL=
