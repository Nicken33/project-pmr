# Talentro web — сборочные переменные. Кладите значения в web/.env.local
# (файл в .gitignore); этот шаблон описывает, что читается кодом.

# Public (exposed to browser) — Google OAuth 2.0 Web client ID.
# Create it in Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized JavaScript origins: http://localhost:3000 (and your production domain).
# Authorized redirect URIs: not required for the implicit/credential flow used here.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Base URL of the catalog API (Go backend, /api/v1/*). Same-origin fallback does
# NOT exist: with this variable empty the site never calls a backend, and the
# catalog, map and activity pages render "адрес бэкенда не задан"
# (web/src/lib/api.ts — apiBaseUrl/isApiEnabled). Local stand:
# http://127.0.0.1:8080. Public: the Caddy origin, because /media is served by
# Caddy, not by the Go service (docs/deploy.md §4.1, §10.4).
NEXT_PUBLIC_API_URL=

# Optional. Base URL that issues the session cookie; defaults to NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_AUTH_URL=

# Canonical origin for metadataBase, robots.txt and sitemap.xml. Left empty, the
# code falls back to the placeholder https://talentro.example — and that
# placeholder would be published inside a real sitemap.
NEXT_PUBLIC_SITE_URL=

# Demo-data switch (web/src/lib/view-mode.ts). For local review only: a public
# build with this flag on would serve mock cards as if they were real listings.
NEXT_PUBLIC_DEMO_DATA=
